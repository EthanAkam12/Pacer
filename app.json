{
  "expo": {
    "name": "Pacely",
    "slug": "pacer",
    "scheme": [
      "pacely",
      "pacer"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "ios": {
      "bundleIdentifier": "com.ethanakam.pacer",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "audio",
          "bluetooth-central"
        ],
        "NSLocationWhenInUseUsageDescription": "Pacely uses your location to measure distance and pace during your runs.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Pacely keeps tracking your run while your phone is locked or in your pocket.",
        "NSBluetoothAlwaysUsageDescription": "Pacely connects to your heart-rate strap."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/adaptive-bg.png",
        "backgroundColor": "#021225"
      },
      "package": "com.ethanakam.pacer",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#021225",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#021225"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Pacely keeps tracking your run while your phone is locked or in your pocket.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Pacely connects to your heart-rate strap."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-sharing"
    ],
    "owner": "ethanakam",
    "extra": {
      "eas": {
        "projectId": "2bb51b8f-79f9-4997-9250-96d0c14aeb8d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2bb51b8f-79f9-4997-9250-96d0c14aeb8d",
      "fallbackToCacheTimeout": 0
    }
  }
}
