{
  "expo": {
    "name": "Pacer",
    "slug": "pacer",
    "scheme": "pacer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "ios": {
      "bundleIdentifier": "com.ethanakam.pacer",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "audio",
          "bluetooth-central"
        ],
        "NSLocationWhenInUseUsageDescription": "Pacer uses your location to measure distance and pace during your runs.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Pacer keeps tracking your run while your phone is locked or in your pocket.",
        "NSBluetoothAlwaysUsageDescription": "Pacer connects to your heart-rate strap."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1B3BCF"
      },
      "package": "com.ethanakam.pacer",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#1B3BCF",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0F1F72"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Pacer keeps tracking your run while your phone is locked or in your pocket.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Pacer connects to your heart-rate strap."
        }
      ]
    ]
  }
}
